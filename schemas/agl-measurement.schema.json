{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aircraftbuyorsell.com/agl/schemas/agl-measurement.schema.json",
  "title": "AGL Measurement",
  "type": "object",
  "required": ["measurement_id", "use_case", "measurement_type", "quantity", "unit", "measurement_state", "scope", "evidence_refs"],
  "properties": {
    "measurement_id": {"type": "string", "minLength": 1},
    "use_case": {"type": "string", "minLength": 1},
    "measurement_type": {"type": "string", "enum": ["processing_volume", "resource_consumption", "outcome", "governance_overhead"]},
    "quantity": {"type": "number", "minimum": 0},
    "unit": {"type": "string", "minLength": 1},
    "processing": {
      "type": "object",
      "properties": {
        "input_tokens": {"type": "number", "minimum": 0},
        "output_tokens": {"type": "number", "minimum": 0},
        "total_processed_tokens": {"type": "number", "minimum": 0},
        "tokenization_method": {"type": "string"},
        "tokenization_version": {"type": "string"},
        "normalized_unit": {"type": "string"},
        "normalization_factor": {"type": "number", "exclusiveMinimum": 0},
        "normalized_quantity": {"type": "number", "minimum": 0}
      },
      "additionalProperties": false
    },
    "measurement_state": {"type": "string", "enum": ["measured", "estimated", "partial", "unavailable", "invalid", "disputed"]},
    "scope": {
      "type": "object",
      "required": ["period_start", "period_end"],
      "properties": {
        "period_start": {"type": "string", "format": "date-time"},
        "period_end": {"type": "string", "format": "date-time"},
        "execution_refs": {"type": "array", "items": {"type": "string"}},
        "service_id": {"type": "string"},
        "agent_id": {"type": "string"}
      },
      "additionalProperties": true
    },
    "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "source_refs": {"type": "array", "items": {"type": "string"}},
    "calculation_method": {"type": "string"},
    "calculation_version": {"type": "string"},
    "generated_at": {"type": "string", "format": "date-time"},
    "integrity": {"type": "object", "additionalProperties": true},
    "metadata": {"type": "object", "additionalProperties": true}
  },
  "additionalProperties": false
}