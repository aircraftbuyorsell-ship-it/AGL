{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aircraftbuyorsell.com/agl/schemas/agl-measurement.schema.json",
  "title": "AGL Measurement",
  "type": "object",
  "required": [
    "measurement_id",
    "unit_id",
    "quantity",
    "unit",
    "measurement_state",
    "scope",
    "evidence_refs"
  ],
  "properties": {
    "measurement_id": {
      "type": "string",
      "minLength": 1
    },
    "unit_id": {
      "type": "string",
      "minLength": 1
    },
    "quantity": {
      "type": "number",
      "minimum": 0
    },
    "unit": {
      "type": "string",
      "minLength": 1
    },
    "measurement_state": {
      "type": "string",
      "enum": [
        "measured",
        "estimated",
        "partial",
        "unavailable",
        "invalid",
        "disputed"
      ]
    },
    "scope": {
      "type": "object",
      "required": [
        "period_start",
        "period_end"
      ],
      "properties": {
        "period_start": {
          "type": "string",
          "format": "date-time"
        },
        "period_end": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": true
    },
    "execution_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "calculation_method": {
      "type": "string"
    },
    "calculation_version": {
      "type": "string"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "integrity": {
      "type": "object",
      "additionalProperties": true
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
