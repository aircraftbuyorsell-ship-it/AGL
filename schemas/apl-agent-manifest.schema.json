{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/aircraftbuyorsell-ship-it/AGL/blob/main/schemas/apl-agent-manifest.schema.json",
  "title": "APL Agent Manifest",
  "description": "Minimal implementation-neutral APL agent manifest.",
  "type": "object",
  "required": ["apl_version", "agent", "provider", "capabilities", "permissions"],
  "properties": {
    "apl_version": { "type": "string" },
    "agent": {
      "type": "object",
      "required": ["id", "name", "version", "status"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "status": { "type": "string", "enum": ["active", "inactive", "suspended", "revoked"] }
      },
      "additionalProperties": true
    },
    "provider": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "organization_id": { "type": "string" }
      },
      "additionalProperties": true
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "level": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "permissions": {
      "type": "object",
      "required": ["allow"],
      "properties": {
        "allow": { "type": "array", "items": { "type": "string" } },
        "deny": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    },
    "autonomy": { "type": "string", "enum": ["A0", "A1", "A2", "A3", "A4"] },
    "trust": { "type": "object", "additionalProperties": true },
    "audit": { "type": "object", "additionalProperties": true },
    "model": { "type": "object", "additionalProperties": true }
  },
  "additionalProperties": false
}
